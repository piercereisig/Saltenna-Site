# Copy to .env for local development:  cp .env.example .env
#
# The Basic-auth gate in src/middleware.ts returns 503 on EVERY page when
# PREVIEW_PASSWORD is unset — it deliberately fails closed rather than open.
# Without this file `npm run dev` serves nothing but the 503 notice.
PREVIEW_PASSWORD=localdev
PREVIEW_USER=saltenna

# NOT needed locally. Video defaults to the R2 bucket in src/videoBase.ts for
# production builds, and `astro dev` serves ../videos from disk. Set this only
# to point a build at a different bucket.
# PUBLIC_VIDEO_BASE=https://pub-555801c7c2ae4ca7a0c96f1fac3f953d.r2.dev/videos
