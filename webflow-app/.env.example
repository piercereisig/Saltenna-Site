# Local development needs NOTHING from this file — src/middleware.ts skips the
# Basic-auth gate under `astro dev`, so http://app.localhost:4321 just opens.
#
# These are only for a real DEPLOYMENT (and for `npm run preview`, which builds
# first and therefore runs the gate). Without PREVIEW_PASSWORD a deployed build
# returns 503 on every page rather than falling open.
PREVIEW_PASSWORD=change-me
PREVIEW_USER=saltenna

# Not needed: video defaults to the R2 bucket in src/videoBase.ts for
# production builds, and `astro dev` serves ../videos from disk.
# PUBLIC_VIDEO_BASE=https://pub-555801c7c2ae4ca7a0c96f1fac3f953d.r2.dev/videos
