---
// Shared chrome for every page. The head, header and footer were byte-identical
// across all six hand-built pages; only the title, meta description and the
// nav item carrying .active ever differed, so those are props.
//
// Asset and page links stay RELATIVE ("css/styles.css", "about.html") exactly
// as they were on the static site. That is deliberate: relative URLs resolve
// against whatever mount path Webflow Cloud serves the app from, so the same
// build works at the domain root or under a subpath like /app with no rewriting.
interface Props {
  title: string;
  description: string;
  active?: "home" | "products" | "maritime" | "communications" | "sensing" | "about";
  // Optional per-page share image (relative path under public/); defaults to
  // the homepage hero montage.
  image?: string;
}

const { title, description, active, image } = Astro.props;

// Production origin, used to build ABSOLUTE canonical + Open Graph URLs (social
// scrapers and canonicals require absolute URLs). Same for every environment on
// purpose: the preview (new.saltenna.com) is gated by Cloudflare Access, and its
// canonical correctly points at the production URL.
const SITE = "https://saltenna.com";

// Cloudflare Web Analytics (privacy-friendly, no cookies). Set
// PUBLIC_CF_BEACON_TOKEN as a build-time env var in the Cloudflare Pages project
// (Web Analytics gives you the token). When unset — local dev, preview, or if
// you instead enable Pages' dashboard Web Analytics toggle — the beacon is not
// emitted, so it never double-counts. Use ONE method, not both.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
// build.format "file" makes pathname end in .html, which correctly matches the
// served subpage URLs (/about.html); only the homepage needs the clean root.
const pagePath = Astro.url.pathname === "/index.html" ? "/" : Astro.url.pathname;
const canonical = new URL(pagePath, SITE).href;
const ogImage = new URL(image ?? "images/posters/hero-montage.jpg", SITE).href;

// Bump these together with the source files to bust caches on redeploy.
const CSS_VERSION = "92";
const JS_VERSION = "63";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Icons. TODO: replace with a purpose-built favicon (square SVG + 32/180px
       PNGs); logo-color.png is the color wordmark used as a stopgap. -->
  <link rel="icon" type="image/png" href="images/logo-color.png" />
  <link rel="apple-touch-icon" href="images/logo-color.png" />
  <meta name="theme-color" content="#0d1424" />

  <!-- Open Graph (LinkedIn, Slack, Facebook) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Saltenna" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="stylesheet" href={`css/styles.css?v=${CSS_VERSION}`} />
</head>
<body>

  <header class="site-header">
    <div class="container nav-wrap">
      <a class="logo" href="index.html" aria-label="Saltenna home">
        <img src="images/logo-white.png" alt="Saltenna" />
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
      <nav class="main-nav">
        <a href="index.html" class={active === "home" ? "active" : undefined}>Home</a>
        <a href="products.html" class={active === "products" ? "active" : undefined}>Products</a>
        <a href="maritime.html" class={active === "maritime" ? "active" : undefined}>Maritime</a>
        <a href="communications.html" class={active === "communications" ? "active" : undefined}>Communications</a>
        <a href="sensing.html" class={active === "sensing" ? "active" : undefined}>Sensing</a>
        <a href="about.html" class={active === "about" ? "active" : undefined}>About</a>
        <a href="contact.html" class="nav-cta">Contact Us</a>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="logo" href="index.html">
            <img src="images/logo-white.png" alt="Saltenna" />
          </a>
          <p>Wireless communications and sensing in the most difficult environments on Earth.</p>
        </div>
        <div>
          <h4>Technology</h4>
          <ul>
            <li><a href="products.html">Products</a></li>
            <li><a href="maritime.html">Maritime</a></li>
            <li><a href="communications.html">Communications</a></li>
            <li><a href="sensing.html">Sensing</a></li>
          </ul>
        </div>
        <div>
          <h4>Company</h4>
          <ul>
            <li><a href="about.html">About</a></li>
            <li><a href="about.html#team">Leadership</a></li>
            <li><a href="contact.html">Contact</a></li>
          </ul>
        </div>
        <div>
          <h4>Headquarters</h4>
          <p>1751 Pinnacle Dr, Suite 600<br />McLean, VA 22102-4007<br />United States</p>
        </div>
      </div>
      <div class="footer-meta">
        <div class="codes">
          <span>CAGE: 7VPY9</span>
          <span>DUNS: 08-0672349</span>
          <span>UEI: MHBLZ1BWMNQ3</span>
        </div>
        <div>© 2026 Saltenna Inc. All rights reserved.</div>
      </div>
    </div>
  </footer>

  <script is:inline src={`js/main.js?v=${JS_VERSION}`}></script>
  {cfBeaconToken && (
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfBeaconToken}"}`}></script>
  )}
</body>
</html>
