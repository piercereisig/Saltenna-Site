---
import Base from "../layouts/Base.astro";
import { VIDEO_BASE } from "../videoBase";

// Static page — generated at build time, not per request. Webflow Cloud
// requires output: "server". These pages were prerendered (`= true`); the
// Basic-auth gate in src/middleware.ts only runs for on-demand routes, so they
// are server-rendered instead. Flip back to `true` and delete the middleware to
// restore static generation.
export const prerender = false;
---

<Base title="Sensing — Saltenna" description="Saltenna’s Plasmonix™ sensing detects and characterizes humans, animals, and objects through solid metal, underwater, and in other environments no sensor could reach before" active="sensing">

  <section class="page-hero color-media sea-hero">
    <video class="bg-video" autoplay muted loop playsinline preload="auto" poster="images/posters/sensing-hero-forest.jpg" aria-hidden="true">
      <source src={`${VIDEO_BASE}/sensing-hero-forest.mp4`} type="video/mp4" />
    </video>
    <div class="container hero-lead">
      <h1>Wireless Sensing and Detection</h1>
    </div>
    <div class="container hero-info">
      <div class="hero-info-tag">
        <p>Sensing where others can't</p>
        <a class="hero-scroll" href="#use-cases" aria-label="Scroll to content">&#8595;</a>
      </div>
      <p class="hero-info-desc">Saltenna is developing technology that can detect and characterize the presence of humans, animals, and objects in new environments considered impossible with current wireless detection technologies</p>
      <nav class="hero-info-links" aria-label="Sensing use cases">
        <a href="#uc-sealed">Sealed Metal</a>
        <a href="#uc-presence">Presence</a>
        <a href="#uc-water">Water</a>
        <a href="#uc-tissue">Tissue</a>
      </nav>
    </div>
  </section>

  <section class="block deep has-fx" id="use-cases">
    <canvas class="fx-canvas" data-fx="sonar" aria-hidden="true"></canvas>
    <div class="container">
      <div class="section-head reveal">
        <h2>Sensing through the opaque</h2>
        <p>Four barriers Plasmonix™ can read through</p>
      </div>
      <div class="split use-case-panel reveal" id="uc-sealed">
        <div>
          <h3>Inside Sealed Metal</h3>
          <p>Saltenna is working on sensor reporting and object detection through solid metal — pressurized tanks, shipping containers, sealed vessels — without drilling holes or running wires. Contents, condition, and chain of custody, read through the wall.</p>
        </div>
        <div class="split-media scene" data-parallax="0.22">
          <img src="images/uc/sensing-iiot.svg?v=2" alt="" loading="lazy">
        </div>
      </div>

      <div class="split reverse use-case-panel reveal" id="uc-presence">
        <div>
          <h3>Presence Through Barriers</h3>
          <p>Saltenna has demonstrated sensing through metal, and is developing detection of presence and activity in spaces nothing else can see into — sealed containers, hulls, and denied environments underwater and ashore</p>
        </div>
        <div class="split-media scene" data-parallax="0.22">
          <img src="images/uc/sensing-detection.svg?v=2" alt="" loading="lazy">
        </div>
      </div>

      <div class="split use-case-panel reveal" id="uc-water">
        <div>
          <h3>Through Water</h3>
          <p>Saltenna believes its Plasmonix™ may monitor what happens beneath the surface — the health of stock and structures, ice-sheet thickness, salinity, long-term environmental change — in places where today's sensors can't report back</p>
        </div>
        <div class="split-media scene" data-parallax="0.22">
          <img src="images/uc/sensing-environmental.svg?v=2" alt="" loading="lazy">
        </div>
      </div>

      <div class="split reverse use-case-panel reveal" id="uc-tissue">
        <div>
          <h3>Through Tissue</h3>
          <p>Saltenna is moving towards scanning organic tissue to detect the presence of cancers and other ailments — the same physics that reads through steel, tuned to living tissue</p>
        </div>
        <div class="split-media scene" data-parallax="0.22">
          <img src="images/uc/sensing-bioimaging.svg?v=2" alt="" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <section class="image-band">
    <video class="lazy-video" muted loop playsinline preload="none" poster="images/posters/band-container-port.jpg" aria-hidden="true">
      <source src={`${VIDEO_BASE}/band-container-port.mp4`} type="video/mp4" />
    </video>
    <div class="container reveal">
      <h2>Every container, accounted for</h2>
    </div>
  </section>

  <section class="block dark has-fx">
    <canvas class="fx-canvas" data-fx="field" aria-hidden="true"></canvas>
    <div class="container">
      <div class="split reveal">
        <div>
          <h3>Leveraging barriers instead of being blocked by them</h3>
          <p>Saltenna's Plasmonix™ waves travel along and through solid metal rather than being blocked by it. Saltenna has demonstrated detection through metal — without drilling holes or running wires, and with vessels, containers, and hulls staying sealed and intact.</p>
        </div>
        <div class="split-media graphic">
          <iframe src="graphics/sealed-container-link.html" title="Interactive 3D: an external coupler sensing a presence sealed inside a metal container by sending a pulse through the wall and reading the echo" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band has-fx">
    <canvas class="fx-canvas" data-fx="field" aria-hidden="true"></canvas>
    <div class="container reveal">
      <h2>Saltenna is evolving fast</h2>
      <p>We are developing seemingly impossible communications and sensing at the edge in the most demanding environments. Contact us to explore and craft powerful unique solutions.</p>
      <a class="btn btn-primary" href="contact.html">Contact Us</a>
    </div>
  </section>
</Base>
