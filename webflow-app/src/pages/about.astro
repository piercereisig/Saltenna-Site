---
import Base from "../layouts/Base.astro";
import { VIDEO_BASE } from "../videoBase";

// Static page — generated at build time, not per request. Webflow Cloud
// requires output: "server". These pages were prerendered (`= true`); the
// Basic-auth gate in src/middleware.ts only runs for on-demand routes, so they
// are server-rendered instead. Flip back to `true` and delete the middleware to
// restore static generation.
export const prerender = false;
---

<Base title="About — Saltenna" description="Saltenna is a dual-use technology company in McLean, VA developing Plasmonix™ wireless communications and sensing, led by pioneers in physics, defense, and engineering" active="about">

  <section class="page-hero color-media sea-hero">
    <video class="bg-video" autoplay muted loop playsinline preload="auto" poster="images/posters/band-drift-ice.jpg" aria-hidden="true">
      <source src={`${VIDEO_BASE}/band-drift-ice.mp4`} type="video/mp4" />
    </video>
    <div class="container hero-lead">
      <h1>Working at the boundary</h1>
    </div>
    <div class="container hero-info">
      <div class="hero-info-tag">
        <p>Est. 2017 — McLean, Virginia</p>
        <a class="hero-scroll" href="#who-we-are" aria-label="Scroll to content">&#8595;</a>
      </div>
      <p class="hero-info-desc">Saltenna is developing communications where land, sea, and air meet — and is always interested in hearing from scientists, engineers, and potential partners</p>
    </div>
  </section>

  <section class="block has-fx" id="who-we-are">
    <canvas class="fx-canvas" data-fx="field" aria-hidden="true"></canvas>
    <div class="container">
      <div class="split reveal" style="grid-template-columns: 1fr; max-width: 820px;">
        <div>
          <h3>A dual-use company strategically located in the Washington DC metro area</h3>
          <p>Saltenna holds multiple patents on its technology and is heavily engaged in further R&amp;D. It has performed on multiple contracts and demonstrated its technology for the U.S. Department of War and commercial customers</p>
        </div>
      </div>
    </div>
  </section>

  <section class="block deep has-fx" id="team">
    <canvas class="fx-canvas" data-fx="field" aria-hidden="true"></canvas>
    <div class="container">
      <div class="section-head reveal">
        <h2>Management Team</h2>
        <p>Executives and scientists with decades of experience across defense, government, semiconductors, wireless, and subsea systems</p>
      </div>
      <div class="team-grid">
        <div class="team-card reveal">
          <img class="avatar" src="images/dendy-young.jpg" alt="M. Dendy Young" />
          <h3>M. Dendy Young</h3>
          <div class="role">Executive Chairman</div>
          <p>Dendy Young brings over 50 years of executive leadership in defense, government, and commercial technology. As Managing Partner of McLean Capital and a founding partner of Blu Venture Investors, he has launched and scaled early-stage ventures with strategic capital and operational expertise. Beyond technology, he operates Hidden Creek Farm in Virginia, a regenerative farm focused on restoring soil health and ecological balance, reflecting his belief that healthy soil yields healthy food and healthy people. B.S. Electrical Engineering and Computer Science, MIT. M.B.A. Harvard Business School.</p>
        </div>
        <div class="team-card reveal">
          <img class="avatar" src="images/igor-smolyaninov.jpg" alt="Dr. Igor Smolyaninov" />
          <h3>Dr. Igor Smolyaninov, PhD</h3>
          <div class="role">CTO and Founder</div>
          <p>Dr. Igor Smolyaninov is a globally recognized physicist with expertise in plasmonics, surface optics, and electromagnetic metamaterials. Former Research Scientist at the University of Maryland, CTO of Gradient Dynamics, and Senior Principal Engineer at BAE Systems, he has authored 400+ papers and holds numerous patents. OSA Fellow, recipient of the Scientific American 50 Award, and gold medalist for young scientists of the USSR Academy of Science, Igor is a pioneer of game-changing technology. M.Sc. Moscow Institute of Physics and Technology. Ph.D. Physics, Kapitza Institute, Russian Academy of Sciences.</p>
        </div>
        <div class="team-card reveal">
          <img class="avatar" src="images/ashley-johnston.jpg" alt="Robert Ashley Johnston" />
          <h3>Robert "Ashley" Johnston</h3>
          <div class="role">COO</div>
          <p>Robert "Ashley" Johnston is a technology executive with over 30 years experience leading growth and innovation across the semiconductor, wireless, and AI software industries. CEO of VanGogh Imaging, a developer of advanced 3D computer vision, machine learning, and generative AI technologies used in consumer electronics, robotics, and medical applications. President of Setcom Wireless Products GmbH, where he restructured the company around wireless IP services and security testing and led its sale to the market leader. Earlier leadership roles at Texas Instruments and Motorola Semiconductor, driving business development and major telecom infrastructure design wins across Europe and Asia. Bachelor of Engineering, Electronic Systems, University of Limerick.</p>
        </div>
        <div class="team-card reveal">
          <img class="avatar" src="images/denny-brisley.jpg" alt="Captain Denny Brisley" />
          <h3>Captain Denny Brisley, USN (Ret.)</h3>
          <div class="role">Chief Strategy Officer</div>
          <p>Denny is an aerospace executive with 30+ years advancing dual-use tech for national security &amp; commercial markets. She held senior executive roles at General Dynamics, SAIC, CAE, and NorthStar Earth &amp; Space. Retired USN Captain (Intelligence), post-9/11 active duty, senior civilian at ONI &amp; OSD HQE, Silicon Valley entrepreneur, Presidential Appointee, Hoover Institution Fellow, and Stanford Visiting Scholar. B.A. International Relations, Stanford University. M.A. Defense and Strategic Studies, U.S. Naval War College.</p>
        </div>
        <div class="team-card reveal">
          <img class="avatar" src="images/john-mulholland.jpg" alt="John Mulholland" />
          <h3>John Mulholland</h3>
          <div class="role">Division President — Energy Systems</div>
          <p>John is a strategic technology leader with over 25 years experience in development of advanced controls infrastructure and sensor systems within both Military and Subsea Oil &amp; Gas markets. He leads projects introducing new technologies and supporting life extension of high-value assets. Numerous patents in wireless subsea sensing and communications and a Senior Member of the IEEE. Associate Professor in Systems Engineering, bridging the gap between high-level academic research and mission-critical industrial applications. M.Eng Electrical &amp; Mechanical Engineering, University of Edinburgh.</p>
        </div>
        <div class="team-card reveal">
          <img class="avatar" src="images/sanjee-singla.jpg" alt="Sanjee Singla" />
          <h3>Sanjee Singla</h3>
          <div class="role">Division President — AI and Robotics</div>
          <p>Sanjee Singla brings 20+ years of innovation in hardware and software engineering, has invented several proprietary technologies, and founded Import Zen, Apply.co, and AT Strategic. A former infrastructure project finance investment banker at Taylor-DeJongh and researcher at Stanford's SIEPR and GSB, Sanjee leads Saltenna's strategy, products, and contracts for AI and Robotic platforms across all domains. B.A. Economics and Physics, Stanford University. M.S. Management Science and Engineering, Stanford University. Certified Associate in Project Management (CAPM), Project Management Institute.</p>
        </div>
        <div class="team-card reveal">
          <img class="avatar" src="images/quirino-balzano.png" alt="Dr. Quirino Balzano" />
          <h3>Dr. Quirino Balzano, PhD</h3>
          <div class="role">Senior Scientist</div>
          <p>Dr. Quirino Balzano is a pioneer in RF dosimetry and antenna technology with 50+ papers and 31 patents. Former VP of Technical Staff at Motorola and researcher at Raytheon's Missile Systems, he led R&amp;D on Patriot phased arrays. Now Senior Staff Researcher at University of Maryland, Quirino advances Saltenna's electromagnetic and Plasmonix™ innovations for defense and extreme environments. Ph.D. Electronics Engineering, University of Rome, La Sapienza, Rome, Italy.</p>
        </div>
        <div class="team-card reveal">
          <img class="avatar" src="images/patrick-higby.jpeg" alt="Maj. Gen. Patrick Higby" />
          <h3>Maj. Gen. Patrick Higby, USAF (Ret.)</h3>
          <div class="role">Advisor</div>
          <p>Principal, Deep Water Point. US Air Force: Director for DevOps &amp; Lethality, Director for Cyberspace Strategy, Commander (81st Training Wing and Keesler, 75th Air Base Wing and Hill AFB), Deputy Commander, White House Communications Agency. B.S. Electrical Engineering, Georgia Institute of Technology. Masters Degree, Electrical Engineering, Colorado Technical University. Masters Degrees in Strategic Studies at USAF War College, National Security and Strategic Studies at U.S. Naval War College.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band has-fx">
    <canvas class="fx-canvas" data-fx="field" aria-hidden="true"></canvas>
    <div class="container reveal">
      <h2>Saltenna is evolving fast</h2>
      <p>We are developing seemingly impossible communications and sensing at the edge in the most demanding environments. Contact us to explore and craft powerful unique solutions.</p>
      <a class="btn btn-primary" href="contact.html">Contact Us</a>
    </div>
  </section>
</Base>
